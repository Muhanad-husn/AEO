{
  "description": "AEO Phase 1 gates and the SessionStart ground-truth reporter.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-status.mjs"],
            "timeout": 20
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node --version > /dev/null 2>&1 || echo \"[AEO] GATES NOT ENFORCING: node did not resolve, so every AEO hook fails open. Install Node 18+ on PATH and restart Claude Code.\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*github.*__merge",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
